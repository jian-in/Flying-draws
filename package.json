{
  "name": "flying-draws",
  "version": "0.1.0",
  "description": "Local interactive canvas & visual workbench for coding agents (built-in Fuxi runtime + MCP)",
  "author": "Bofei Jian",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jian-in/Flying-draws.git"
  },
  "main": "./out/main/index.js",
  "bin": {
    "flying-draws": "out/bridge/index.js",
    "flying-draws-mcp": "out/bridge/index.js"
  },
  "files": [
    "out/bridge/",
    "out/main/",
    "out/preload/",
    "out/renderer/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "mcp",
    "excalidraw",
    "canvas",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "visual-diff"
  ],
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/copy-fonts.mjs && node scripts/fetch-fuxi.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsc -p tsconfig.bridge.json",
    "build:bridge": "tsc -p tsconfig.bridge.json",
    "fetch:fuxi": "node scripts/fetch-fuxi.mjs --require",
    "build:fuxi": "node scripts/build-fuxi.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:canvas": "node scripts/package-desktop.mjs --without-fuxi",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:fast": "node scripts/test-fast.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:draw": "node scripts/e2e-draw.mjs",
    "e2e:agent": "node scripts/e2e-agent.mjs",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "koffi": "3.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}

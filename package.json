    "typecheck": "tsc --noEmit -p tsconfig.json",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}

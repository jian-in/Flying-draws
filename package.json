{
  "name": "flying-draws",
  "version": "0.1.1",
  "description": "Local interactive canvas & visual workbench for coding agents (built-in Fuxi runtime + MCP)",
  "author": "Bofei Jian",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jian-in/Flying-draws.git"
  },
  "main": "./out/main/index.js",
  "bin": {
    "flying-draws": "out/bridge/index.js",
    "flying-draws-mcp": "out/bridge/index.js"
  },
  "files": [
    "resources/icon/",
    "out/bridge/",
    "out/main/",
    "out/preload/",
    "out/renderer/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "mcp",
    "excalidraw",
    "canvas",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "visual-diff"
  ],
  "scripts": {
    "postinstall": "node -e \"const fs=require('node:fs'),cp=require('node:child_process');for(const f of ['node_modules/electron/install.js','scripts/copy-fonts.mjs','scripts/fetch-fuxi.mjs']){if(!fs.existsSync(f))continue;const r=cp.spawnSync(process.execPath,[f],{stdio:'inherit'});if(r.error)throw r.error;if(r.status!==0)process.exit(r.status??1)}\"",
    "prepack": "npm run build",
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsc -p tsconfig.bridge.json",
    "icons": "electron scripts/generate-icons.cjs",
    "build:bridge": "tsc -p tsconfig.bridge.json",
    "fetch:fuxi": "node scripts/fetch-fuxi.mjs --require",
    "build:fuxi": "node scripts/build-fuxi.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:canvas": "node scripts/package-desktop.mjs --without-fuxi",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.bridge.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:fast": "node scripts/test-fast.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:draw": "node scripts/e2e-draw.mjs",
    "e2e:agent": "node scripts/e2e-agent.mjs",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "koffi": "3.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "resedit": "3.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "katex": "~0.18.11",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  }
}

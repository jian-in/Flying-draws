{
  "name": "sketchlink",
  "version": "0.0.1",
  "private": true,
  "description": "A local canvas that lets any agent read what you draw",
  "license": "MIT",
  "main": "./out/main/index.js",
  "bin": {
    "sketchlink-mcp": "out/bridge/index.js"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/copy-fonts.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsc -p tsconfig.bridge.json",
    "build:bridge": "tsc -p tsconfig.bridge.json",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
